@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css');

/* ========================================================
   MODO ESCURO PREMIUM (Padrão)
   ======================================================== */
:root {
  --bg-primary: #0d1321;
  --bg-secondary: #131c2e;
  --accent-orange: #ff6b00;
  --accent-orange-hover: #e05e00;
  --glass-bg: rgba(255, 255, 255, 0.03);
  --glass-border: rgba(255, 255, 255, 0.06);
  --text-main: #f8fafc;        /* Texto Branco */
  --text-muted: #94a3b8;
  --sidebar-active: rgba(255, 107, 0, 0.15);
  --shadow-premium: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
}

/* ========================================================
   MODO CLARO (Corrigido para Visibilidade Total)
   ======================================================== */
body.light-mode {
  --bg-primary: #f8fafc;
  --bg-secondary: #ffffff;
  --accent-orange: #ff6b00;
  --accent-orange-hover: #e05e00;
  --glass-bg: #ffffff;
  --glass-border: #cbd5e1;
  --text-main: #0f172a;        /* Força texto Escuro (Ardósia) */
  --text-muted: #64748b;       /* Força subtítulos acinzentados */
  --sidebar-active: rgba(255, 107, 0, 0.1);
  --shadow-premium: 0 8px 32px 0 rgba(148, 163, 184, 0.15);
}

/* Configurações Globais dos Elementos */
body {
  background-color: var(--bg-primary);
  color: var(--text-main);
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* Forçar os títulos e textos dentro do card a respeitarem o Modo Claro/Escuro */
.auth-form-card h2 {
  color: var(--text-main) !important;
}
.input-group-premium label {
  color: var(--text-muted) !important;
}

/* INPUTS CORRIGIDOS: dynamic text color */
input {
  background: var(--bg-secondary) !important;
  border: 1px solid var(--glass-border) !important;
  color: var(--text-main) !important; /* Texto digitado assume a cor certa automaticamente */
  padding: 14px 16px;
  border-radius: 12px;
  outline: none;
  transition: all 0.3s ease;
  width: 100%;
}
input::placeholder {
  color: var(--text-muted);
}

/* Configurações Base do App */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}


/* Utilidades Globais baseadas no Stitch */
.glass-card {
  background: var(--bg-secondary);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  box-shadow: var(--shadow-premium);
  transition: background-color 0.3s ease, border 0.3s ease, box-shadow 0.3s ease;
}

.btn-premium {
  background: var(--accent-orange);
  color: #ffffff !important;
  border: none;
  padding: 14px 24px;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.btn-premium:hover {
  background: var(--accent-orange-hover);
  transform: translateY(-1px);
}

input {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  color: var(--text-main);
  padding: 14px 16px;
  border-radius: 12px;
  outline: none;
  transition: all 0.3s ease;
  width: 100%;
}

input:focus {
  border-color: var(--accent-orange);
  box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.15);
}

body.light-mode {
  --bg-primary: #f1f5f9;
  --bg-secondary: #ffffff;
  --text-main: #0f172a; /* Azul quase preto para legibilidade */
  --text-sub: #475569;
  --text-muted: #94a3b8;
  --border: #e2e8f0;
  --glass-bg: rgba(255, 255, 255, 0.8);
}

/* Garante que ícones da barra lateral fiquem visíveis */
body.light-mode .nav-item {
  color: #475569;
}

body.light-mode .nav-item.active {
  color: #ffffff;
}

body.light-mode .sidebar {
    background: #ffffff;
    border-right: 1px solid #e2e8f0;
}

body.light-mode {
  --bg-primary: #f8fafc;
  --bg-secondary: #ffffff;
  --bg-card: #ffffff;
  --text-main: #1e293b; /* Texto escuro para o modo claro */
  --text-sub: #475569;
  --border: #e2e8f0;
  --accent: #ff6b00;
}

/* Forçar visibilidade do ícone do carrinho e menu */
body.light-mode .btn-cart {
  background: #1e293b; /* Fundo escuro para o botão do carrinho no modo claro */
  color: #ffffff;
}

body.light-mode .nav-item {
  color: #64748b;
}

body.light-mode .nav-item.active {
  background: #ff6b00;
  color: #ffffff;
}

/* Corrigir inputs no modo claro */
body.light-mode .search-input {
  background: #f1f5f9;
  color: #1e293b;
  border: 1px solid #cbd5e1;
}

.alert-error {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid #ef4444;
  color: #ef4444;
  padding: 12px 16px;
  border-radius: 12px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.85rem;
  font-weight: 600;
  animation: shake 0.4s ease-in-out;
}

/* Efeito de tremer quando o erro aparece */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-5px); }
  75% { transform: translateX(5px); }
}

/* Ajuste para o Modo Claro */
body.light-mode .alert-error {
  background: #fee2e2;
  border-color: #f87171;
  color: #b91c1c;
}
